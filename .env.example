# OakSeerr Configuration
# Copy this file to .env and fill in your values

# Database path (SQLite)
OAKSEERR_DB_PATH=/app/config/oakseerr.db

# JWT Secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string

# Server
PORT=5055
LISTEN_ADDR=0.0.0.0:5055
LOG_LEVEL=oakseerr=info,tower_http=info

# CORS — set to your frontend URL. * is NOT recommended and is rejected by the backend.
CORS_ORIGIN=http://localhost:5055

# Jellyfin
JELLYFIN_URL=
JELLYFIN_API_KEY=

# Demo mode — when enabled, anyone can log in as admin without a password
DEMO_MODE=false
