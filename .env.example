# OakSeerr Configuration
# Copy this file to .env and fill in your values

# Database (SQLite by default)
DATABASE_URL=sqlite://data/oakseerr.db?mode=rwc

# Server
LISTEN_ADDR=0.0.0.0:5055
JWT_SECRET=change-me-to-a-random-string

# Jellyfin SSO (optional)
JELLYFIN_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=your-jellyfin-api-key

# Demo mode (default: false)
# When enabled, anyone can log in as admin without a password.
# Disable for production!
DEMO_MODE=false

# Logging
LOG_LEVEL=oakseerr=info,tower_http=info
